# Copie este arquivo para .env e preencha GOOGLE_API_KEY.
# Nunca commite o arquivo .env.

# Google Gemini (modelos escolhidos no ADR-002)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0

# PostgreSQL (valores apenas para desenvolvimento local; também usados pelo Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PG_VECTOR_COLLECTION_NAME=document_chunks

# PDF para ingestão
PDF_PATH=document.pdf

# true exibe detalhes técnicos dos erros e logs no terminal
DEBUG=false
